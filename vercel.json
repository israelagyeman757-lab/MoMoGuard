{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/phone-page/index.html"
    },
    {
      "source": "/phone-page",
      "destination": "/phone-page/index.html"
    },
    {
      "source": "/training-app",
      "destination": "/training-app/index.html"
    },
    {
      "source": "/community-console",
      "destination": "/community-console/index.html"
    }
  ]
}