{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/phone-page/index.html"
    },
    {
      "source": "/phone-page",
      "destination": "/phone-page/index.html"
    },
    {
      "source": "/innovate-reps",
      "destination": "/innovate-reps/index.html"
    },
    {
      "source": "/demo-control",
      "destination": "/demo-control/index.html"
    }
  ]
}