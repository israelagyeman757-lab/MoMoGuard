# Optional: persistent SQLite path (local dev)
COMMUNITY_SQLITE_PATH=./data/momoguard.db

# Optional Supabase (future durable adapter)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo moderator tokens (override in production demos)
MODERATOR_DEMO_TOKEN=demo-mod-token
VIEWER_DEMO_TOKEN=demo-view-token

# Set to 0 in tests to avoid auto-seeding
MOMOGUARD_AUTO_SEED=1