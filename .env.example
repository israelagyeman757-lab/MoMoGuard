# Copy to .env and fill in. NEVER commit real keys.
# Sandbox / Glance keys arrive after the opening ceremony; plugs are simulated until then.
GLANCE_API_KEY=
GLANCE_BASE_URL=
SANDBOX_BASE_URL=
SANDBOX_API_KEY=
# Pause timeout in seconds (default 180 = about 3 minutes)
PAUSE_TIMEOUT_S=180

# --- MTN MoMo hackathon sandbox (https://hackathon.innofemme.org/t/team-08) ---
# Set to "mtn_sandbox" to make the controller use the real sandbox bank plug
# (controller/plugs/mtn_momo_bank_plug.py) instead of the simulated BankPlug.
# Leave unset/"simulated" to keep using the pretend in-memory bank.
BANK_PLUG_MODE=simulated

# Base URL for the team's sandbox API (no trailing slash).
MTN_SANDBOX_BASE_URL=https://hackathon.innofemme.org/api/w/team-08

# Issued at /t/team-08/telco/mtn -> "Give a company API access" -> "Issue credentials".
# NEVER commit real values here -- this file only documents the variable names.
MTN_MOMO_CLIENT_ID=
MTN_MOMO_API_KEY=

# Optional overrides if the live sandbox docs show different paths than the
# MTN-MoMo-Open-API-style defaults baked into mtn_momo_bank_plug.py.
# MTN_MOMO_TRANSFER_PATH=/v1_0/transfer
# MTN_MOMO_TRANSFER_STATUS_PATH=/v1_0/transfer/{reference_id}
# MTN_MOMO_BALANCE_PATH=/v1_0/account/balance
# MTN_NETWORK_SUBSCRIBER_PATH=/network/mtn/v1/subscribers/{msisdn}
# MTN_NETWORK_TOKEN_PATH=/network/mtn/token
# MTN_SANDBOX_TIMEOUT_S=10