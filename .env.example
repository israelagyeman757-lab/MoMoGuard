# Copy to .env and fill in. NEVER commit real keys.
SANDBOX_BASE_URL=
SANDBOX_API_KEY=

# --- Rancard Glance (fraud-intelligence / reverse number lookup) ---
# Real product (https://www.rancard.com/products/glance/): number threat
# status, risk level, history, and centralised threat reporting. Rancard's
# own developer page does not publish a public request/response schema or
# base URL -- get those directly from Rancard. Until then,
# controller/plugs/rancard_glance_plug.py runs as a clearly-labelled stub
# and ignores these two values entirely (RANCARD_GLANCE_MODE stays "stub").
# NEVER commit a real key here -- this file only documents the variable
# names; put the real value in your own untracked .env only.
# Either name works locally; never commit a real value.
GLANCE_DEV_KEY=
RANCARD_GLANCE_API_KEY=
RANCARD_GLANCE_BASE_URL=https://glance-api.rancardmobility.com
# Live lookup uses GET .../sandbox/msisdn/aggregates (see docs/rancard-glance-integration.md).
RANCARD_GLANCE_TIMEOUT_S=8
# stub (default) or live — lookup stays stub until RANCARD_GLANCE_LOOKUP_PATH is set.
RANCARD_GLANCE_MODE=stub
# stub (default in CI) or live — forwards POST /report to Glance sandbox reporting API.
RANCARD_GLANCE_REPORT_MODE=stub
# Sandbox-only simulatedSourceId values (see docs/rancard-glance-integration.md).
# RANCARD_GLANCE_SIM_SOURCE_ID=SIM-A
# RANCARD_GLANCE_SIM_SOURCE_REP=SIM-A
# RANCARD_GLANCE_SIM_SOURCE_CUSTOMER=SIM-A
# Pause timeout in seconds (default 180 = about 3 minutes)
PAUSE_TIMEOUT_S=180

# --- MTN MoMo hackathon sandbox (https://hackathon.innofemme.org/t/team-08) ---
# Set to "mtn_sandbox" to make the controller use the real sandbox bank plug
# (controller/plugs/mtn_momo_bank_plug.py) instead of the simulated BankPlug.
# Leave unset/"simulated" to keep using the pretend in-memory bank.
BANK_PLUG_MODE=simulated

# Base URL for the team's sandbox API (no trailing slash).
MTN_SANDBOX_BASE_URL=https://hackathon.innofemme.org/api/w/team-08

# Issued at /t/team-08/telco/mtn -> "Give a company API access" -> "Issue credentials".
# NEVER commit real values here -- this file only documents the variable names.
MTN_MOMO_CLIENT_ID=
MTN_MOMO_API_KEY=

# Optional overrides -- defaults below are confirmed live against the
# team-08 sandbox (collection = debit a subscriber in, disbursement = pay a
# subscriber out, both through this company's merchant wallet). Override
# only if another team/sandbox build uses different paths.
# MTN_MOMO_REQUESTTOPAY_PATH=/collection/v1_0/requesttopay
# MTN_MOMO_TRANSFER_PATH=/disbursement/v1_0/transfer
# MTN_MOMO_BALANCE_PATH=/collection/v1_0/account/balance
# MTN_NETWORK_SUBSCRIBER_PATH=/network/mtn/v1/subscribers/{msisdn}
# MTN_SANDBOX_TIMEOUT_S=10

# NOTE: actual money movement additionally requires a merchant wallet linked
# to these credentials in the sandbox's MTN back office (Merchants tab ->
# "Onboard merchant", then select that merchant when issuing/re-issuing API
# credentials). Subscriber lookups and auth work without one; requesttopay/
# transfer return a clear "no merchant wallet" error until one is linked.
# For MoMoGuard's own credentials this is now linked and live-confirmed
# working (see PR notes) -- new teams/credentials still need to do this once.

# Optional: set to a real subscriber MSISDN to make smoke_mtn_sandbox.py also
# submit a real GHS 1 collection request (requesttopay) FROM that subscriber
# and poll it to a real terminal status. This proves the submit-then-poll
# machinery works; a collection normally needs the payer to approve it (e.g.
# on their phone) before it can succeed, so a FAILED/EXPIRED result here
# without that approval step is expected, not a failure of this script.
# Leave unset to skip this extra live check.
# MTN_SMOKE_TEST_MSISDN=

# For reports-and-checker/live_round_trip_demo.py only -- the sandbox TEAM
# key (not a MoMo credential; separate auth used for creating test customers
# with a known PIN and for driving the USSD approval flow). Treat exactly
# like the MoMo credentials above: local .env only, never commit it.
# MTN_TEAM_KEY=
# This company's merchant MSISDN (e.g. the line you registered when
# onboarding the merchant), so the demo script can show the wallet balance
# actually changing. Optional -- the demo still runs without it, just skips
# that extra check.
# MTN_MERCHANT_MSISDN=