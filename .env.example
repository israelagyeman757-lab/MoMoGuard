# Optional: persistent SQLite path (local dev)
COMMUNITY_SQLITE_PATH=./data/momoguard.db

# Supabase (durable backend on Vercel when both set; apply supabase/migrations/20261128120000_blueprint.sql)
# SUPABASE_URL=https://ytukecpastecnvlikait.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_HTTP_TIMEOUT_S=10

# Demo moderator tokens (override in production demos)
MODERATOR_DEMO_TOKEN=demo-mod-token
VIEWER_DEMO_TOKEN=demo-view-token

# Set to 0 in tests to avoid auto-seeding
MOMOGUARD_AUTO_SEED=1

# Innofemme team-08 sandbox (optional; unset = no outbound sandbox calls)
INNOFEMME_TEAM_KEY=